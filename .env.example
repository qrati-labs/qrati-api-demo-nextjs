# Demo app's own auth (better-auth + MongoDB) — not Qrati's API auth.
MONGODB_URI=mongodb://localhost:27017/qrati-api-demo
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3010

# Qrati platform API (api.qrati.com/v1) — server-side secret, never exposed to the browser.
QRATI_API_KEY=
QRATI_BASE_URL=https://api.qrati.com/v1
